# Every text file is stored with LF line endings, whatever the committer's own line-ending settings, so
# the vendored trees keep matching their upstream blobs and their manifests.
* text=auto

# Model artifacts are never committed at model size: the model files are SuperEmbedder release assets.
# The small .sslm test fixtures that are committed are plain binary files.
*.sslm   binary

# Binary Unreal and image assets route through Git LFS.
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

*.cpp      text eol=lf
*.h        text eol=lf
*.inc      text eol=lf
*.cs       text eol=lf
*.py       text eol=lf
*.sh       text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.json     text eol=lf
*.ini      text eol=lf
*.uplugin  text eol=lf
*.uproject text eol=lf

# The vendored trees are byte-exact copies of upstream release tags, checked against
# VENDORED_MANIFEST.sha256. Nothing in them may become an LFS pointer, and their own
# .gitattributes (vendored with them) govern their line endings.
Plugins/SuperEmbedderUnreal/Source/ThirdParty/** -filter -diff -merge
